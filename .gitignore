# OS and tooling noise
.DS_Store
*.tmp
*.log
__pycache__/
node_modules/

# Credentials never enter the repo
.env
.env.*

# local-only material. A privacy label alone protects nothing: every local-only file
# must be matched here. scripts/check_privacy.py fails if one is not.
private/
exports/
raw/**/local/
*.local.md

# Recordings stay local; keep their transcripts
*.m4a
*.mp3
*.wav
*.mp4
*.mov
